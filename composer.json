{
    "name": "saizul/wp-plugin-boilerplate-pro",
    "description": "A modern WordPress plugin starter with PSR-4 autoloading, a DI container, service providers and a rename script.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Saizul Amin",
            "homepage": "https://saizul.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "SaizulAmin\\PluginBoilerplate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SaizulAmin\\PluginBoilerplate\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "rename": "@php bin/rename.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
